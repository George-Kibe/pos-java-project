# Copy to .env and fill in, or run `make env` to generate one with random secrets.
# .env is git-ignored and must never be committed.
# In production these come from Docker secrets, not from this file.

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pos
POSTGRES_SUPERUSER=pos_admin
POSTGRES_SUPERUSER_PASSWORD=

# One login role per service; each can touch its own schema only.
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=
PURCHASING_DB_USER=purchasing_user
PURCHASING_DB_PASSWORD=
SALES_DB_USER=sales_user
SALES_DB_PASSWORD=
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=

# ----------------------------------------------------------------------------
# Kafka
# ----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
TOPIC_PARTITIONS=3
TOPIC_REPLICATION=1

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# ----------------------------------------------------------------------------
# SMTP - Mailpit locally, Gmail/Workspace in production.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true,
# SMTP_USERNAME=<your address>, SMTP_PASSWORD=<16-char App Password, not your login password>.
# ----------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM="Supermarket POS <no-reply@example.com>"

# ----------------------------------------------------------------------------
# JWT (Phase 3)
# ----------------------------------------------------------------------------
JWT_ISSUER=http://localhost:8081
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
JWT_KEYSTORE_PATH=/run/secrets/jwt-keystore.p12
JWT_KEYSTORE_PASSWORD=

# ----------------------------------------------------------------------------
# First administrator, created only when the users table is empty.
# There is deliberately no default password: a well-known one is how a system is
# breached on day one. The account must change its password at first sign-in.
# ----------------------------------------------------------------------------
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_EMAIL=admin@pos.local
AUTH_BOOTSTRAP_PASSWORD=

# ----------------------------------------------------------------------------
# Gateway
# ----------------------------------------------------------------------------
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# OTP policy (Phase 3)
# ----------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL=PT10M
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=PT60S

# ----------------------------------------------------------------------------
# M-Pesa Daraja (Phase 10) - leave blank until you have sandbox credentials
# ----------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# The secret path segment Daraja's callbacks must carry; generated by `make env`. Daraja cannot
# sign or authenticate a callback, so this token is what stops anyone else marking a sale paid.
MPESA_CALLBACK_TOKEN=
# Reversals (M-Pesa refunds) only: the API operator's name and its encrypted SecurityCredential
# from the Daraja portal. Without them an M-Pesa refund is raised for a person to settle.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Optional, comma-separated: Safaricom's published callback addresses.
MPESA_CALLBACK_ALLOWED_IPS=

# ----------------------------------------------------------------------------
# Loyalty (Phase 11) - the scheme's economics; blank uses the defaults shown
# ----------------------------------------------------------------------------
LOYALTY_SPEND_PER_POINT=100
LOYALTY_POINT_VALUE=1
LOYALTY_EXPIRY_MONTHS=12
LOYALTY_TIER_WINDOW_MONTHS=12

# ----------------------------------------------------------------------------
# Locale
# ----------------------------------------------------------------------------
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
